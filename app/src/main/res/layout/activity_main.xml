<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Title -->
    <TextView
        android:id="@+id/appTitle"
        android:text="Qualcomm"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/appSubtitle"
        android:text="On-Device Intelligent Navigation Assistant for Accessibility"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Team Members (replace names with your real list) -->
    <TextView
        android:id="@+id/teamNames"
        android:text="Team Members:\nTim Laux\nTyler Ramanata\nGordon Chen\nAidan McKeithan\nRyan Sorrell"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Open Camera -->
    <Button
        android:id="@+id/openCameraBtn"
        android:text="Open Camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Exit App -->
    <Button
        android:id="@+id/exitBtn"
        android:text="Exit App"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
